# Copy to .env for local, or set in Render dashboard
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
AUTH_SECRET=generate-a-long-random-string-at-least-32-chars
ADMIN_ID=admin
ADMIN_PASS=change-me-to-a-strong-password
# Optional extra origins (comma-separated) if frontend is on another domain
ALLOWED_ORIGINS=
